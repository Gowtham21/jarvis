# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# What Jarvis calls you
JARVIS_USER_NAME=Gowtham

# Wake word that must be heard before a command (set JARVIS_WAKE_WORD= to disable)
JARVIS_WAKE_WORD=jarvis

# Claude model and reasoning effort (low is fast and cheap for spoken chat)
JARVIS_MODEL=claude-opus-5-5
JARVIS_EFFORT=low

# Speech to text: "google" (online, no setup) or "whisper" (offline, pip install -e .[whisper])
JARVIS_STT=google
JARVIS_WHISPER_MODEL=base
# Languages you speak, most used first (Google tries them in order; Whisper auto-detects)
JARVIS_LANGUAGES=en-IN,ta-IN

# Text to speech: "pyttsx3" (offline, Windows voices), "edge" (neural, pip install -e .[neural-tts])
# "clone" (your own voice via XTTS v2, 17 languages, no Tamil; pip install -e .[clone])
# or "indic" (your own voice via IndicF5, 11 Indian languages incl. Tamil; see README)
JARVIS_TTS=pyttsx3

# Needed for "indic": accept the model terms at https://huggingface.co/ai4bharat/IndicF5
# and create a read token at https://huggingface.co/settings/tokens
HF_TOKEN=
JARVIS_EDGE_VOICE=en-IN-PrabhatNeural
JARVIS_SPEECH_RATE=170

# Folders the "play music" / "play video" tools look in (optional)
JARVIS_MUSIC_DIR=
JARVIS_VIDEO_DIR=

# Voice profile: every understood utterance is saved here as a reference clip for "clone"
JARVIS_COLLECT_VOICE=true
JARVIS_VOICE_DIR=voice_profile
JARVIS_CLONE_LANGUAGE=en
JARVIS_CLONE_MIN_SECONDS=6
